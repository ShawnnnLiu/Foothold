{
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "date_collected": {
      "format": "date",
      "title": "Date Collected",
      "type": "string"
    },
    "doc_id": {
      "pattern": "^doc_[0-9a-f]{16}$",
      "title": "Doc Id",
      "type": "string"
    },
    "license_note": {
      "minLength": 1,
      "title": "License Note",
      "type": "string"
    },
    "source_published_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Published Date"
    },
    "source_type": {
      "enum": [
        "bulletin_course",
        "bulletin_requirement"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "source_url": {
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "doc_id",
    "source_url",
    "source_type",
    "license_note",
    "date_collected",
    "content_hash",
    "title"
  ],
  "title": "CorpusDocument",
  "type": "object"
}
