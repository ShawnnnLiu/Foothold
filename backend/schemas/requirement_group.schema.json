{
  "additionalProperties": false,
  "properties": {
    "choose_n": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Choose N"
    },
    "major_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "title": "Major Id",
      "type": "string"
    },
    "member_courses": {
      "items": {
        "type": "string"
      },
      "title": "Member Courses",
      "type": "array"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "note_text": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note Text"
    },
    "requirement_group_id": {
      "pattern": "^rg_[0-9a-f]{16}$",
      "title": "Requirement Group Id",
      "type": "string"
    },
    "rule_kind": {
      "enum": [
        "all",
        "choose_n",
        "note"
      ],
      "title": "Rule Kind",
      "type": "string"
    }
  },
  "required": [
    "requirement_group_id",
    "major_id",
    "name",
    "rule_kind",
    "member_courses"
  ],
  "title": "RequirementGroup",
  "type": "object"
}
