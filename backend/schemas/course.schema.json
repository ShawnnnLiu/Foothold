{
  "$defs": {
    "AllOf": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/CourseLeaf"
              },
              {
                "$ref": "#/$defs/NoteLeaf"
              }
            ]
          },
          "minItems": 1,
          "title": "All",
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "AllOf",
      "type": "object"
    },
    "AnyOf": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/AllOf"
              },
              {
                "$ref": "#/$defs/AnyOf"
              },
              {
                "$ref": "#/$defs/CourseLeaf"
              },
              {
                "$ref": "#/$defs/NoteLeaf"
              }
            ]
          },
          "minItems": 1,
          "title": "Any",
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "AnyOf",
      "type": "object"
    },
    "CourseLeaf": {
      "additionalProperties": false,
      "properties": {
        "course": {
          "title": "Course",
          "type": "string"
        },
        "equivalent_ok": {
          "default": false,
          "title": "Equivalent Ok",
          "type": "boolean"
        }
      },
      "required": [
        "course"
      ],
      "title": "CourseLeaf",
      "type": "object"
    },
    "NoteLeaf": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "note"
      ],
      "title": "NoteLeaf",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bulletin_url": {
      "title": "Bulletin Url",
      "type": "string"
    },
    "course_code": {
      "title": "Course Code",
      "type": "string"
    },
    "department_code": {
      "maxLength": 8,
      "minLength": 1,
      "pattern": "^[A-Z]+$",
      "title": "Department Code",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "points_max": {
      "maximum": 20,
      "title": "Points Max",
      "type": "number"
    },
    "points_min": {
      "exclusiveMinimum": 0,
      "maximum": 20,
      "title": "Points Min",
      "type": "number"
    },
    "prereq_confidence": {
      "enum": [
        "parsed",
        "fallback_flat",
        "none"
      ],
      "title": "Prereq Confidence",
      "type": "string"
    },
    "prereq_expr": {
      "anyOf": [
        {
          "$ref": "#/$defs/AllOf"
        },
        {
          "$ref": "#/$defs/AnyOf"
        },
        {
          "$ref": "#/$defs/CourseLeaf"
        },
        {
          "$ref": "#/$defs/NoteLeaf"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prereq Expr"
    },
    "prereq_prose": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prereq Prose"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "course_code",
    "title",
    "points_min",
    "points_max",
    "prereq_confidence",
    "bulletin_url",
    "department_code"
  ],
  "title": "Course",
  "type": "object"
}
